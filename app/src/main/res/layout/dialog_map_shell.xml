<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_map_dialog_card"
    android:clipToOutline="true"
    android:elevation="8dp"
    android:orientation="vertical"
    android:outlineProvider="background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_map_dialog_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tvMapDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMapDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:textColor="#111111"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutMapDialogExtraActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/layoutMapDialogCustom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <View
        android:id="@+id/viewMapDialogFooterDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/map_dialog_divider" />

    <LinearLayout
        android:id="@+id/layoutMapDialogFooter"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnMapDialogCancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="取消"
            android:textColor="@color/map_dialog_footer_cancel"
            android:textSize="16sp" />

        <View
            android:id="@+id/viewMapDialogFooterBtnDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/map_dialog_divider" />

        <TextView
            android:id="@+id/btnMapDialogConfirm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="确定"
            android:textColor="@color/map_dialog_footer_confirm"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnMapDialogSingle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:text="关闭"
        android:textColor="@color/map_dialog_footer_cancel"
        android:textSize="16sp"
        android:visibility="gone" />
</LinearLayout>
