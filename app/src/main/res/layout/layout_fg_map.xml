<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 必须在地图之上、侧栏/弹层之下，否则会盖住定位菜单等控件 -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/ivHeading"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:tint="#E53935"
        android:src="@drawable/ic_location_heading"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutGroupStatsBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        android:background="#99000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tvGroupStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="活动组成员: 0 在线: 0"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <View
            android:id="@+id/viewActiveGrpMeetingLamp"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_meeting_lamp_red" />

        <TextView
            android:id="@+id/tvActiveGrpMeetingEntry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="暂无会议"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/layoutFloatingVideo"
        android:layout_width="160dp"
        android:layout_height="216dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="56dp"
        android:background="#D91A1A1A"
        android:elevation="9dp"
        android:visibility="gone">



        <FrameLayout
            android:id="@+id/layoutFloatingFragmentHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="34dp"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/ivCompass"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:background="@android:color/transparent"
        android:elevation="4dp"
        android:visibility="visible">

        <FrameLayout
            android:id="@+id/compassTopRotatingLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/compass_base_map" />
        </FrameLayout>

        <ImageView
            android:id="@+id/ivCompassPointerTop"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="4dp"
            android:src="@drawable/compass_pointer" />
    </FrameLayout>

    <!-- 导航/定位/罗盘右对齐竖排；定位菜单仅贴在定位钮左侧，避免与导航同列左对齐时被菜单盖住 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutRightTools"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="14dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:clickable="false"
        android:focusable="false"
        app:layout_optimizationLevel="none">

        <ImageView
            android:id="@+id/ivNavBtn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_compass_disk"
            android:contentDescription="navigation"
            android:elevation="3dp"
            android:padding="8dp"
            android:src="@drawable/ic_nav_route"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivLocateBtn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_compass_disk"
            android:contentDescription="locate"
            android:elevation="3dp"
            android:padding="8dp"
            android:src="@drawable/ic_locate_crosshair"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivNavBtn" />

        <ImageView
            android:id="@+id/ivCompassBtn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_compass_disk"
            android:contentDescription="compass"
            android:elevation="3dp"
            android:padding="8dp"
            android:src="@drawable/hsp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivLocateBtn" />

        <androidx.cardview.widget.CardView
            android:id="@+id/layoutLocatePanel"
            android:layout_width="240dp"

            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="-50dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            app:cardUseCompatPadding="false"
            app:contentPadding="0dp"
            app:layout_constraintBottom_toBottomOf="@id/ivLocateBtn"
            app:layout_constraintEnd_toStartOf="@id/ivLocateBtn"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1.0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"

                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_map_panel_header"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="定位"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvLocateMenuSelf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    android:text="定位自己"
                    android:textColor="#111111"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvLocateMenuAll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    android:text="定位全员"
                    android:textColor="#111111"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvLocateMenuFollow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    android:text="开启跟随"
                    android:textColor="#111111"
                    android:textSize="16sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/ivZoomInBtn"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="-108dp"
        android:background="@drawable/bg_compass_disk"
        android:clickable="true"
        android:focusable="true"
        android:elevation="3dp"
        android:padding="8dp"
        android:src="@drawable/ic_zoom_in_plus"
        android:contentDescription="地图放大" />

    <ImageView
        android:id="@+id/ivZoomOutBtn"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="-54dp"
        android:background="@drawable/bg_compass_disk"
        android:clickable="true"
        android:focusable="true"
        android:elevation="3dp"
        android:padding="8dp"
        android:src="@drawable/ic_zoom_out_minus"
        android:contentDescription="地图缩小" />

    <ImageView
        android:id="@+id/ivMarkBtn"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="14dp"
        android:background="@drawable/bg_compass_disk"
        android:elevation="3dp"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_edit"
        android:contentDescription="mark" />

    <ImageView
        android:id="@+id/ivMarkLineFilterBtn"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="54dp"
        android:background="@drawable/bg_compass_disk"
        android:clickable="true"
        android:focusable="true"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_mark_link_all"
        android:contentDescription="连线筛选" />

    <ImageView
        android:id="@+id/ivMarkNoteListBtn"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="108dp"
        android:background="@drawable/bg_compass_disk"
        android:clickable="true"
        android:elevation="3dp"
        android:focusable="true"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_mark_note"
        android:contentDescription="同步注记列表，长按重新同步" />

    <FrameLayout
        android:id="@+id/layoutCompassPanel"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="center"
        android:background="@android:color/transparent"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_compass_disk">

            <FrameLayout
                android:id="@+id/layoutCompassRotatingLayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/bg_compass_disk" />
            </FrameLayout>

            <ImageView
                android:id="@+id/ivCompassNeedleLarge"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="8dp"
                android:src="@drawable/ic_compass_needle" />
        </FrameLayout>
    </FrameLayout>

    <HorizontalScrollView
        android:id="@+id/remoteCameraStripScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="52dp"
        android:fillViewport="false"
        android:scrollbars="none"
        android:visibility="gone"
        android:elevation="6dp">

        <LinearLayout
            android:id="@+id/remoteCameraStrip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/layoutNavBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="52dp"
        android:background="#E6000000"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="6dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvNavInstruction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnNavStop"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="结束导航" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/layoutLayerBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="72dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.cardview.widget.CardView
            android:id="@+id/layoutLayerPanel"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="50dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            app:cardUseCompatPadding="false"
            app:contentPadding="0dp">

            <LinearLayout
                android:id="@+id/layoutLayerPanelBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/layoutLayerPanelHeader"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_map_panel_header"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="44dp"
                        android:text="地图图层"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLayerOfflineDataAdd"
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end|center_vertical"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:contentDescription="添加离线数据"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/white"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/layerPanelScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="false"
                    android:overScrollMode="ifContentScrolls"
                    android:scrollbars="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <CheckBox
                    android:id="@+id/cbLayerVector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:buttonTint="@color/layer_checkbox_button"
                    android:text="矢量地图"
                    android:textColor="@color/layer_checkbox_text"
                    android:textSize="16sp" />

                <CheckBox
                    android:id="@+id/cbLayerImagery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:buttonTint="@color/layer_checkbox_button"
                    android:text="影像地图"
                    android:textColor="@color/layer_checkbox_text"
                    android:textSize="16sp" />

                <CheckBox
                    android:id="@+id/cbLayerAnnotation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:buttonTint="@color/layer_checkbox_button"
                    android:text="在线注记"
                    android:textColor="@color/layer_checkbox_text"
                    android:textSize="16sp" />

                <CheckBox
                    android:id="@+id/cbLayerOffline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:buttonTint="@color/layer_checkbox_button"
                    android:text="离线矢量"
                    android:textColor="@color/layer_checkbox_text"
                    android:textSize="16sp" />

                <CheckBox
                    android:id="@+id/cbLayerOfflineImagery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:buttonTint="@color/layer_checkbox_button"
                    android:text="离线影像"
                    android:textColor="@color/layer_checkbox_text"
                    android:textSize="16sp" />

                <CheckBox
                    android:id="@+id/cbLayerOfflineAnnotation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:buttonTint="@color/layer_checkbox_button"
                    android:text="离线注记"
                    android:textColor="@color/layer_checkbox_text"
                    android:textSize="16sp" />
                </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <ImageView
            android:id="@+id/ivLayerBtn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="bottom|end"
            android:adjustViewBounds="true"
            android:background="@drawable/bg_compass_disk"
            android:contentDescription="图层"
            android:elevation="3dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_map_layers" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvCurrentCoord"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="#99000000"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:text="类型: --  经度: --  纬度: --  高程: --"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

</FrameLayout>
