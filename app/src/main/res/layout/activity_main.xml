<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/layout_total"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity">

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/vpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/div_tab_bar" />

        <View
            android:id="@+id/div_tab_bar"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_above="@+id/ly_tab_bar"
            android:background="#ECECEC" />

        <LinearLayout
            android:id="@+id/ly_tab_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_alignParentBottom="true"
            android:background="@color/white"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tab_map"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:id="@+id/tab_map_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:scaleType="centerInside"
                    android:src="@drawable/map1"
                    android:tint="@color/tab_icon_tint" />

                <TextView
                    android:id="@+id/txt_map"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:duplicateParentState="true"
                    android:text="地图"
                    android:textColor="@drawable/tab_menu_text"
                    android:textSize="11sp" />

                <View
                    android:id="@+id/tab_map_indicator"
                    android:layout_width="28dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="3dp"
                    android:background="@color/tab_selected_gold"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_msg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:id="@+id/tab_msg_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:scaleType="centerInside"
                    android:src="@drawable/message"
                    android:tint="@color/tab_icon_tint" />

                <TextView
                    android:id="@+id/txt_msg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:duplicateParentState="true"
                    android:text="消息"
                    android:textColor="@drawable/tab_menu_text"
                    android:textSize="11sp" />

                <View
                    android:id="@+id/tab_msg_indicator"
                    android:layout_width="28dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="3dp"
                    android:background="@color/tab_selected_gold"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_contact"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:id="@+id/tab_contact_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:scaleType="centerInside"
                    android:src="@drawable/mys"
                    android:tint="@color/tab_icon_tint" />

                <TextView
                    android:id="@+id/txt_contact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:duplicateParentState="true"
                    android:text="联系人"
                    android:textColor="@drawable/tab_menu_text"
                    android:textSize="11sp" />

                <View
                    android:id="@+id/tab_contact_indicator"
                    android:layout_width="28dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="3dp"
                    android:background="@color/tab_selected_gold"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_me"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:id="@+id/tab_me_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:scaleType="centerInside"
                    android:src="@drawable/my"
                    android:tint="@color/tab_icon_tint" />

                <TextView
                    android:id="@+id/txt_me"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:duplicateParentState="true"
                    android:text="我"
                    android:textColor="@drawable/tab_menu_text"
                    android:textSize="11sp" />

                <View
                    android:id="@+id/tab_me_indicator"
                    android:layout_width="28dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="3dp"
                    android:background="@color/tab_selected_gold"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <include layout="@layout/layout_floating_av_shell" />

</FrameLayout>
