<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/Layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/topMenu"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/txt_back"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_alignParentLeft="true"
            android:layout_marginLeft="8dp"
            android:gravity="center"
            android:textSize="28sp"
            android:textColor="@color/text_topbar"
            android:text="&lt;"/>

        <TextView
            android:id="@+id/txt_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:textSize="18sp"
            android:textColor="@color/text_topbar"
            android:text="qyMessenger"/>



        <View
            android:id="@+id/div_topMenu"
            android:layout_width="match_parent"
            android:layout_height="2px"
            android:layout_alignParentBottom="true"
            android:background="@color/div_white" />

    </RelativeLayout>


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.1"/>



    <TextView
        android:id="@+id/staticUsrName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Name:"
        android:textSize="18sp"
        android:layout_marginTop="70dp"
        app:layout_constraintLeft_toRightOf="@id/guide"
        app:layout_constraintTop_toBottomOf="@id/topMenu" />

    <TextView
        android:id="@+id/dwmc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="company"
        android:textSize="18sp"
        android:layout_marginLeft="20dp"
        app:layout_constraintLeft_toRightOf="@+id/guide"
        app:layout_constraintTop_toBottomOf="@+id/staticUsrName" />

    <TextView
        android:id="@+id/usrName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="zhangsan"
        android:textSize="18sp"
        android:layout_marginLeft="20dp"
        app:layout_constraintLeft_toRightOf="@+id/guide"
        app:layout_constraintTop_toBottomOf="@+id/dwmc" />

    <TextView
        android:id="@+id/staticIdInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ID:"
        android:textSize="18sp"
        app:layout_constraintLeft_toRightOf="@id/guide"
        app:layout_constraintTop_toBottomOf="@+id/usrName" />
    <TextView
        android:id="@+id/idInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="123"
        android:textSize="18sp"
        android:layout_marginLeft="20dp"
        app:layout_constraintLeft_toRightOf="@+id/guide"
        app:layout_constraintTop_toBottomOf="@+id/staticIdInfo" />

      
</androidx.constraintlayout.widget.ConstraintLayout>
