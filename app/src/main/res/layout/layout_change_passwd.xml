<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_centerVertical="true"
    android:layout_height="match_parent"
    >
    <TextView
        android:layout_marginTop="30dp"
        android:id="@+id/textView_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="修改密码"
        android:textColor="#000000"
        android:textSize="48sp"
        android:textStyle="bold"
        />

    <TextView
        android:id="@+id/description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="卫星云视频平台"
        android:textColor="#000000"
        android:textSize="@dimen/description_text_size"
        />


    <TextView
        android:layout_marginTop="@dimen/login_services_tv_margin_top"
        android:id="@+id/textView_server"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="服务器地址:"
        android:textColor="#000000"
        android:textSize="16sp" />

    <EditText
        android:layout_marginTop="14dp"
        android:id="@+id/editText_server"
        android:layout_width="300dp"
        android:layout_height="34dp"
        android:textSize="14sp"

        android:background="@drawable/edit_style_text"
        android:hint="请输入"
        android:inputType="textPersonName"

        />

    <TextView
        android:layout_marginTop="14dp"
        android:id="@+id/textView_usrName"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="用户名:"
        android:textColor="#000000"
        android:textSize="16sp"

        />

    <EditText
        android:layout_marginTop="14dp"
        android:layout_width="300dp"
        android:layout_height="34dp"
        android:textSize="14sp"
        android:id="@+id/editText_usrName"
        android:background="@drawable/edit_style_text"
        android:hint="请输入"
        android:inputType="textPersonName"

        />

    <TextView
        android:layout_marginTop="14dp"
        android:id="@+id/textView_passwd"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="密码:"
        android:textColor="#000000"
        android:textSize="16sp"

        />

    <EditText
        android:layout_marginTop="14dp"
        android:id="@+id/editText_passwd"
        android:layout_width="300dp"
        android:layout_height="34dp"
        android:textSize="14sp"
        android:background="@drawable/edit_style_text"
        android:hint="请输入"
        android:inputType="textPassword" />

    <TextView
        android:layout_marginTop="30dp"
        android:gravity="center"
        android:id="@+id/button_login"
        android:layout_width="300dp"
        android:layout_height="40dp"
        android:background="#0083ff"
        android:text="登录"
        android:textColor="#ffffff"
        android:textSize="18sp" />
    <TextView
        android:gravity="end"
        android:layout_marginTop="14dp"
        android:id="@+id/change_passwd"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="修改密码"
        android:textColor="#0083ff"
        android:textSize="16sp"

        />

</LinearLayout>
